<%= page_head "Gallery", lede: "The same screen of every tool, side by side. Each frame is the page the tool serves; what drifts apart shows here first." do %>
  <%# The twelve fields, drawn over every frame: the grid only organises
      when the empty fields are as planned as the full ones, and a page
      that fills half its measure shows here as half. CSS reads the box;
      no script. %>
  <label class="choice"><input type="checkbox" id="fields" class="gallery__fields"> Show the fields</label>
<% end %>

<% @screens.each do |screen| %>
  <section class="gallery">
    <h2><%= screen.name %></h2>
    <p class="hint"><%= screen.note %></p>

    <div class="gallery__row">
      <% screen.frames.each do |frame| %>
        <figure class="gallery__frame">
          <% if frame.path %>
            <%# Loaded at the width the tools are laid out for and scaled down,
                so the frames compare like for like: a page narrowed to a
                third of the screen would have stacked its registers and
                proved nothing. %>
            <iframe src="<%= frame.path %>" title="<%= frame.name %>: <%= screen.name %>" loading="lazy" width="1440" height="900"></iframe>
          <% else %>
            <p class="empty">Nothing in <%= frame.name %> to open yet.</p>
          <% end %>
          <figcaption class="micro"><%= link_to frame.name, frame.path || frame.home %><%= " — #{frame.path}" if frame.path %></figcaption>
        </figure>
      <% end %>
    </div>
  </section>
<% end %>
