<% content_for :title, "Forgot your password?" %>

<header>
  <h1 class="page-title">Forgot your password?</h1>
  <p class="lede">Say which address, and a way to set a new one goes there.</p>
</header>

<%= its_swiss_form_with url: passwords_path do |form| %>
  <%= form.email_field :email_address, label: "Email", required: true, autofocus: true,
        autocomplete: "username", value: params[:email_address] %>
  <%= form.submit "Email reset instructions" %>
<% end %>
