<% content_for :title, "Sign in" %>

<header>
  <h1 class="page-title">Sign in</h1>
  <p class="lede">The chassis is yours. Nothing in it is reachable until you say who you are.</p>
</header>

<%= its_swiss_form_with url: session_path do |form| %>
  <%= form.email_field :email_address, label: "Email", required: true, autofocus: true,
        autocomplete: "username", value: params[:email_address] %>
  <%= form.password_field :password, label: "Password", required: true,
        autocomplete: "current-password", maxlength: 72 %>
  <%= form.submit "Sign in" %>
<% end %>

<p class="hint">
  <%= link_to "Forgot your password?", new_password_path, class: "link-quiet" %>
</p>
