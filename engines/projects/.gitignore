# Rooted at this engine, because the chassis's own .gitignore is rooted at the
# chassis and does not reach in here.

# Ignore bundler config.
/.bundle

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# The dummy application's runtime files, and the lock a gem does not carry.
/test/dummy/log/*
!/test/dummy/log/.keep
/test/dummy/tmp/*
!/test/dummy/tmp/.keep
/test/dummy/storage/*
!/test/dummy/storage/.keep
/test/dummy/db/*.sqlite3
/test/dummy/db/*.sqlite3-*
/Gemfile.lock
/*.gem
