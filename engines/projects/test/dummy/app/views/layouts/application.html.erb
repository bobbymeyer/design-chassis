<%# What a host's layout has to do for the engine: render its-swiss's shell,
    and put the engine's :sections where the destinations go. The route
    helpers are called through main_app, because inside an engine's request
    the bare names are the engine's. %>
<% content_for :mark do %>
  <%= link_to "Dummy", main_app.root_path %>
<% end %>

<% content_for :nav do %>
  <%= nav_link_to "Projects", "/projects", current: request.path.start_with?("/projects") %>
<% end %>

<%= render template: "layouts/its_swiss/shell" %>
